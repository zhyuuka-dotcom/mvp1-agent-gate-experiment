+def is_log_format_name(value):
+    """
+    Heuristic to decide whether a --log-format value is a log_format *name*
+    (e.g. "main") rather than an inline format string or a built-in keyword.
+
+    A value is treated as a name when it is not one of the built-in formats
+    and does not look like a format string (format strings reference nginx
+    variables such as ``$remote_addr``).
+    """
+    if value is None:
+        return False
+    if value in BUILTIN_LOG_FORMATS:
+        return False
+    return '$' not in value
+
+
+def resolve_log_format(log_format, config=None):
+    """
+    Resolve a --log-format value to an actual nginx log format string.
+
+    Users often pass the *name* of a ``log_format`` directive defined in their
+    nginx configuration (e.g. ``ngxtop -f main``). In that case the name is
+    looked up in the nginx config and replaced with the corresponding format
+    string so that log lines can be parsed.
+
+    :param log_format: value given to --log-format (a name or a format string)
+    :param config: optional path to the nginx config file; when omitted the
+                   path is detected (or taken from --config by the caller)
+    :return: the resolved format string; the original value if it is not a
+             name, or if the name cannot be found in the config.
+    """
+    if not is_log_format_name(log_format):
+        return log_format
+
+    if config is None:
+        return log_format
+    if not os.path.exists(config):
+        return log_format
+
+    with open(config) as f:
+        config_str = f.read()
+
+    log_formats = dict(get_log_formats(config_str))
+    return log_formats.get(log_format, log_format)
+
+
